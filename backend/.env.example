# Variables de Entorno - SAPC Chawal Backend
# Copiar a .env y configurar valores reales

# Servidor
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=super_secret_seed_chawal_2026_jwt
JWT_EXPIRES_IN=8h

# Base de Datos MySQL
# Crear la BD con: CREATE DATABASE chawal_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Cargar: backend/db/schema.sql y luego backend/db/seed.sql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password_mysql
DB_NAME=chawal_db

# Configuración de Seguridad
BCRYPT_ROUNDS=10

# CORS Configuration (para producción)
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000
